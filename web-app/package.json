{
  "name": "serverless-s3-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:online": "cross-env RUN_ONLINE_INTEGRATION=1 vitest run test/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@carbonplan/zarr-layer": "~0.5.0",
    "@sveltestrap/sveltestrap": "^7.1.0",
    "@zarrita/storage": "~0.2.0",
    "maplibre-gl": "~5.24.0",
    "zarrita": "~0.7.3"
  }
}
